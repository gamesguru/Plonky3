# Justfile - Command runner for p3-tensor-pcs crate development

# List available recipes
_helpt:
    @just --list

# Fast check of this crate's compilation
check:
    cargo check

# Format this crate's code using nightly fmt
fmt:
    cargo +nightly fmt

# Automatically fix Clippy warnings on nightly with pedantic and performance lints enabled
fix:
    cargo +nightly clippy --all-features --all-targets --allow-dirty --fix -- -W clippy::perf -W clippy::pedantic

# Run Clippy checks across all targets of this crate on nightly with performance and pedantic lints
clippy:
    cargo +nightly clippy --all-features --all-targets -- -W clippy::perf -W clippy::pedantic --no-deps

# Run all tests in this crate
test:
    cargo test

# Run the asymptotic scaling benchmark suite for this crate
bench:
    cargo test --release --test scaling -- --nocapture

# Run code coverage analysis using llvm-cov for this crate only
cov:
    cargo llvm-cov --all-features --all-targets
